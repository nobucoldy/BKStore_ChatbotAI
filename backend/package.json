{
  "name": "bkstore-backend",
  "version": "1.0.0",
  "description": "Backend API for BK-Store Tech E-Commerce and AI Chatbot",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test:api": "tsx src/test-api.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@langchain/core": "^0.3.40",
    "@langchain/google-genai": "^0.1.12",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.13.3",
    "zod": "^3.24.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  },
  "keywords": [
    "express",
    "typescript",
    "langchain",
    "gemini",
    "postgresql"
  ],
  "author": "BK-Store Team",
  "license": "ISC"
}
