# ==========================================
# BK-Store Environment Configuration
# ==========================================

# Server Ports
PORT=5000
CLIENT_URL=http://localhost:3000

# Google Gemini API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_BACKUP=your_second_gemini_api_key_here

# JWT Secret
JWT_SECRET=bkstore_super_secret_jwt_key_2026

# Database (Used when running outside Docker)
# When running with Docker Compose, DATABASE_URL is configured automatically
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/bkstore
