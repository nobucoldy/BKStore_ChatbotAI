# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL + PGVector)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/bkstore

# Google Gemini API (Hỗ trợ nhiều key tự động xoay vòng khi hết Quota)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_BACKUP=your_second_gemini_api_key_here
# Hoặc danh sách nhiều key: GEMINI_API_KEYS=key1,key2,key3

# JWT Secret for Admin Auth (can be randomized)
JWT_SECRET=bkstore_super_secret_jwt_key_2026
